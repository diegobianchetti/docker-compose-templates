# =============================================================================
# .env.example — Registry Privado
# =============================================================================
# Copie para .env e preencha com os valores reais.
#   cp .env.example .env
#
# NUNCA commite o .env. O arquivo auth/htpasswd também não deve ser commitado.
# =============================================================================

# Prefixo para nomes de containers, redes e volumes
COMPOSE_PROJECT_NAME=registry

# Porta HTTPS publicada no host para acesso ao registry
REGISTRY_PORT=443

# Nível de log do registry (debug | info | warn | error)
# Usar `warn` em produção para reduzir volume de log
REGISTRY_LOG_LEVEL=warn

# Diretório com os certificados TLS no host (fullchain.pem e privkey.pem)
TLS_CERT_DIR=./nginx/certs

# Caminho para o arquivo htpasswd com usuários autorizados
# Gerar com:
#   docker run --rm httpd:2.4-alpine htpasswd -Bbn usuario senha > auth/htpasswd
# O flag -B usa bcrypt (obrigatório — MD5 é inseguro para produção)
HTPASSWD_FILE=./auth/htpasswd
