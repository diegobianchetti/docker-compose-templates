# =============================================================================
# .env.example — Web Clássico
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env
#
# NUNCA commite o arquivo .env. Ele está listado no .gitignore.
# Este .env.example deve estar no repositório: documenta as variáveis
# necessárias sem expor valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Identidade do projeto
# -----------------------------------------------------------------------------
# Prefixo usado em nomes de containers, redes e volumes.
# Evita colisão quando múltiplos projetos rodam no mesmo host Docker.
COMPOSE_PROJECT_NAME=webapp

# -----------------------------------------------------------------------------
# nginx
# -----------------------------------------------------------------------------
# Portas publicadas no host para o nginx.
# Em produção atrás de um load balancer, pode ser 127.0.0.1:8080:80
# para não expor diretamente ao mundo.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Diretório com os certificados TLS no host (fullchain.pem e privkey.pem)
# Exemplo com Let's Encrypt: /etc/letsencrypt/live/app.example.br
TLS_CERT_DIR=./nginx/certs

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_ENV=production

# Porta interna em que a aplicação escuta (dentro do container)
APP_PORT=8080

# Chave secreta da aplicação (sessões, HMAC, etc.)
# Gerar com: openssl rand -hex 32
APP_SECRET_KEY=TROQUE_POR_VALOR_ALEATORIO_32_BYTES

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=appdb

# Flags adicionais para initdb (opcional)
# Exemplo: --encoding=UTF8 --locale=pt_BR.UTF-8
POSTGRES_INITDB_ARGS=--encoding=UTF8
